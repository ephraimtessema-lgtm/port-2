# ========================================================
# Ephraim Tessema Portfolio - AI Assistant Configuration (Groq API)
# ========================================================
# Copy this file to .env and insert your Groq API key from https://console.groq.com/keys

# AI Provider configured for Groq
AI_PROVIDER=groq

# Your secret Groq API key (starts with gsk_...)
AI_API_KEY=gsk_your_groq_api_key_here

# Ultra-fast recommended Groq model
AI_MODEL=llama-3.3-70b-versatile

# Groq API endpoint
AI_BASE_URL=https://api.groq.com/openai/v1/chat/completions

# Security & Cost Controls
RATE_LIMIT_PER_MINUTE=10
MAX_OUTPUT_TOKENS=350
